pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Setup') {
            steps {
                bat 'npm ci'
            }
        }
        stage('Build Test') {
            steps {
                bat 'npm run build || echo "Build failed but continuing for PR test"'
            }
        }
        stage('Smoke Test') {
            steps {
                bat 'call smoke_test.bat http://localhost:3000 || echo "Smoke test failed but continuing for PR test"'
            }
        }
    }
}
